BOT_TOKEN=YOUR_BOT_TOKEN
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH
PHONE_NUMBER=YOUR_PHONE_NUMBER
TELEGRAM_SESSION=YOUR_TELETHON_STRING_SESSION

# All source channel IDs, comma separated
SOURCE_CHANNELS=-1003593544389,-100YOUR_SECOND_CHANNEL,-100YOUR_THIRD_CHANNEL
TARGET_CHANNEL=-1004415621706
POLL_INTERVAL=3

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low

NEW_MENTION=@PrimeAnalysiss

# Optional per-source watermark style.
# Allowed profiles: cappersfree, pickssman, both
# If omitted, new sources default to both.
WATERMARK_PROFILES=-1003593544389:cappersfree,-100YOUR_SECOND_CHANNEL:pickssman,-100YOUR_THIRD_CHANNEL:both

# Four cleaned variations per successfully cleaned source item
GENERATE_VARIATIONS=true
VARIATION_COUNT=4
